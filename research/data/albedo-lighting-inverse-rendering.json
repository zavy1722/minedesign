    {
      "name": "ramamoorthi_irradiance_constants",
      "units": "dimensionless multipliers on radiance SH coefficients L_lm",
      "columns": [
        "constant",
        "value",
        "definition"
      ],
      "rows": [
        [
          "c1",
          0.429043,
          "A2 * 0.546274"
        ],
        [
          "c2",
          0.511664,
          "A1 * 0.488603 / 2"
        ],
        [
          "c3",
          0.743125,
          "A2 * 3 * 0.315392"
        ],
        [
          "c4",
          0.886227,
          "A0 * 0.282095"
        ],
        [
          "c5",
          0.247708,
          "A2 * 0.315392"
        ]
      ],
      "population": "mathematics (Ramamoorthi & Hanrahan 2001)",
      "source_urls": [],
      "status": "knowledge",
      "notes": "E(n) = c1 L22 (x^2-y^2) + c3 L20 z^2 + c4 L00 - c5 L20 + 2 c1 (L2-2 xy + L21 xz + L2-1 yz) + 2 c2 (L11 x + L1-1 y + L10 z). Outgoing Lambertian radiance = albedo * E / pi."
    },
